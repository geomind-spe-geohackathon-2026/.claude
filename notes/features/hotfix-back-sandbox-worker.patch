+
+# Agent tools (feature agent-tools-2026-11-05)
+# Not used in dev: compose.yml (production) gives the worker container the host's docker group;
+# stack-up runs the worker on the host.
+DOCKER_GID=
+# stack-up exports none instead when the sandbox image is missing.
+ASSISTANT_SANDBOX=docker
+# The image stack-up pulls or builds: gemini-sandbox:<installed gemini version>.
+GEOMIND_SANDBOX_IMAGE=gemini-sandbox:0.6.5
+GEOMIND_SANDBOX_TIMEOUT=60s
+GEOMIND_SANDBOX_MEMORY=1g
+GEOMIND_SANDBOX_DISK=256m
+GEOMIND_SANDBOX_CPU=1
+# Empty in dev: no SearXNG, so web_search and read_web_page are not offered.
+GEOMIND_SEARCH_URL=
